/* ==============================================================================
   POWER BI DAX MASTER LIBRARY: GLOBAL ENTERPRISE PERFORMANCE DASHBOARD
   Dataset: Fact_Orders, Dim_Customers, Dim_Products, Dim_Managers, KPI_Targets, Dim_Calendar
   Author: Senior Power BI Analytics Architect
   ============================================================================== */

-- =============================================================================
-- SECTION 1: CORE FINANCIAL & VOLUME MEASURES
-- =============================================================================

Total Orders = 
COUNTROWS(Fact_Orders)

Total Units Sold = 
SUM(Fact_Orders[Quantity])

Gross Revenue = 
SUM(Fact_Orders[Gross_Sales])

Total Discount = 
SUM(Fact_Orders[Discount_Amount])

Average Discount % = 
DIVIDE(
    [Total Discount],
    [Gross Revenue],
    0
)

Net Revenue = 
SUM(Fact_Orders[Net_Sales])

Total COGS = 
SUM(Fact_Orders[Total_Cost])

Gross Profit = 
SUM(Fact_Orders[Gross_Profit])

Total Shipping Cost = 
SUM(Fact_Orders[Shipping_Cost])

Net Profit = 
SUM(Fact_Orders[Net_Profit])

Profit Margin % = 
DIVIDE(
    [Net Profit],
    [Net Revenue],
    0
)

COGS % = 
DIVIDE(
    [Total COGS],
    [Net Revenue],
    0
)


-- =============================================================================
-- SECTION 2: CUSTOMER & BASKET SIZE METRICS
-- =============================================================================

Unique Customers = 
DISTINCTCOUNT(Fact_Orders[Customer_ID])

Average Order Value = 
DIVIDE(
    [Net Revenue],
    [Total Orders],
    0
)

Average Units Per Order = 
DIVIDE(
    [Total Units Sold],
    [Total Orders],
    0
)

Average Customer Rating = 
AVERAGE(Fact_Orders[Customer_Rating])

Revenue Per Customer = 
DIVIDE(
    [Net Revenue],
    [Unique Customers],
    0
)

Orders Per Customer = 
DIVIDE(
    [Total Orders],
    [Unique Customers],
    0
)


-- =============================================================================
-- SECTION 3: OPERATIONS, LOGISTICS & RETURN ANALYSIS
-- =============================================================================

Delivered Orders = 
CALCULATE(
    COUNTROWS(Fact_Orders),
    Fact_Orders[Order_Status] = "Delivered"
)

Total Returns = 
CALCULATE(
    COUNTROWS(Fact_Orders),
    Fact_Orders[Order_Status] = "Returned"
)

Return Rate % = 
DIVIDE(
    [Total Returns],
    [Total Orders],
    0
)

Returned Revenue Lost = 
CALCULATE(
    SUM(Fact_Orders[Net_Sales]),
    Fact_Orders[Order_Status] = "Returned"
)

Avg Delivery Transit Days = 
AVERAGE(Fact_Orders[Transit_Days])

Expedited Shipping Orders = 
CALCULATE(
    COUNTROWS(Fact_Orders),
    Fact_Orders[Ship_Mode] IN {"Same Day", "First Class"}
)

Expedited Shipping Share % = 
DIVIDE(
    [Expedited Shipping Orders],
    [Total Orders],
    0
)


-- =============================================================================
-- SECTION 4: TIME INTELLIGENCE & YEAR-OVER-YEAR (YoY) / MoM
-- Note: Requires Dim_Calendar marked as Date Table
-- =============================================================================

Sales Prior Year (PY) = 
CALCULATE(
    [Net Revenue],
    SAMEPERIODLASTYEAR(Dim_Calendar[Date])
)

YoY Sales Growth $ = 
[Net Revenue] - [Sales Prior Year (PY)]

YoY Sales Growth % = 
DIVIDE(
    [YoY Sales Growth $],
    [Sales Prior Year (PY)],
    0
)

Profit Prior Year (PY) = 
CALCULATE(
    [Net Profit],
    SAMEPERIODLASTYEAR(Dim_Calendar[Date])
)

YoY Profit Growth $ = 
[Net Profit] - [Profit Prior Year (PY)]

YoY Profit Growth % = 
DIVIDE(
    [YoY Profit Growth $],
    [Profit Prior Year (PY)],
    0
)

Sales Previous Month (PM) = 
CALCULATE(
    [Net Revenue],
    PREVIOUSMONTH(Dim_Calendar[Date])
)

MoM Sales Growth % = 
DIVIDE(
    [Net Revenue] - [Sales Previous Month (PM)],
    [Sales Previous Month (PM)],
    0
)

YTD Revenue = 
TOTALYTD(
    [Net Revenue],
    Dim_Calendar[Date]
)

QTD Revenue = 
TOTALQTD(
    [Net Revenue],
    Dim_Calendar[Date]
)

MTD Revenue = 
TOTALMTD(
    [Net Revenue],
    Dim_Calendar[Date]
)

YTD Profit = 
TOTALYTD(
    [Net Profit],
    Dim_Calendar[Date]
)

Rolling 3-Month Average Revenue = 
CALCULATE(
    DIVIDE([Net Revenue], 3, 0),
    DATESINPERIOD(
        Dim_Calendar[Date],
        LASTDATE(Dim_Calendar[Date]),
        -3,
        MONTH
    )
)


-- =============================================================================
-- SECTION 5: BUDGET TARGET VS. ACTUAL PERFORMANCE (GAUGES & BULLET CHARTS)
-- =============================================================================

Target Revenue = 
SUM(KPI_Targets[Target_Sales])

Target Profit = 
SUM(KPI_Targets[Target_Profit])

Revenue Variance to Target $ = 
[Net Revenue] - [Target Revenue]

Target Achievement % = 
DIVIDE(
    [Net Revenue],
    [Target Revenue],
    0
)

Profit Variance to Target $ = 
[Net Profit] - [Target Profit]

Profit Target Achievement % = 
DIVIDE(
    [Net Profit],
    [Target Profit],
    0
)


-- =============================================================================
-- SECTION 6: DYNAMIC KPI FORMATTING STRINGS & CONDITIONAL COLORING
-- =============================================================================

YoY Growth Card Callout = 
VAR Growth = [YoY Sales Growth %]
RETURN
IF(
    ISBLANK(Growth),
    "-",
    IF(
        Growth >= 0,
        "▲ +" & FORMAT(Growth, "0.0%"),
        "▼ " & FORMAT(Growth, "0.0%")
    )
)

Profit Margin Color Hex = 
IF(
    [Profit Margin %] >= 0.25,
    "#107C41",  -- Deep Forest Green (Healthy Margin)
    IF(
        [Profit Margin %] >= 0.15,
        "#F2C80F",  -- Amber/Yellow (Moderate Margin)
        "#D83B01"   -- Red (Low / Compression Risk)
    )
)

Target Status Text = 
IF(
    [Target Achievement %] >= 1.0,
    "Target Achieved (100%+)",
    IF(
        [Target Achievement %] >= 0.90,
        "Near Target (90% - 99%)",
        "Below Target (<90%)"
    )
)

